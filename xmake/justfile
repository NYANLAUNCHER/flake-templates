export pname := env('pname')
export out := env('out')

# Build project
build:
    xmake build

# Setup project
setup:
    xmake project -k compile_commands --lsp=clangd

# Handle installing application files
install:
    xmake install

# Uninstall application files
uninstall:
    xmake uninstall

# Build then run executable
run:
    xmake run

# Delete all files ignored by .gitignore
[confirm("Save all files untracked by git with `git stash` before confirming.")]
clean:
    git clean -fdX
